# Copy to .env and fill in. NEVER commit .env.
TRV_API_KEY=din-nyckel-från-trafikverket

# Password for the admin page (/admin.html). Leave empty to disable the admin page.
ADMIN_PASSWORD=

# The settings below are start values. Everything except secrets and infrastructure
# can also be changed on the admin page, which then takes precedence.

# Optional settings (defaults shown)
# HOST_PORT=8933        # host port used by docker-compose
# TIMEZONE=Europe/Stockholm
# COLLECT_INTERVAL_MINUTES=5
# TRV_FULLSIZE=false
# SNAPSHOT_RETENTION_DAYS=90
# ARCHIVE_RETENTION_DAYS=365
# NIGHTLY_HOUR=2
# NIGHTLY_MINUTE=0
# HWACCEL=auto            # auto | nvidia | vaapi | qsv | cpu
# VAAPI_DEVICE=/dev/dri/renderD128
# MAX_CONCURRENT_JOBS=8
# MAX_GPU_ENCODES=6
# OUTPUT_FPS=30
# GIF_WIDTH=480
# GIF_FPS=10
# GIF_MAX_FRAMES=150
# TEMP_OVERLAY_DEFAULT=true      # road temperature graph on unless a camera says otherwise
# TEMP_STATION_MAX_KM=20        # road temperature graph: max distance to a weather station
# TEMP_COLLECT_INTERVAL_MINUTES=15
# DEFAULT_ENABLED_CAMERAS=SE_STA_CAMERA_0_1075001058,SE_STA_CAMERA_0_1075001996
# LOG_LEVEL=INFO
# PUID=1000              # uid/gid the app runs as; /data is chown'ed to it on start
# PGID=1000
